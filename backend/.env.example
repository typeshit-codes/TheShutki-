# hPanel → your Node.js app → Environment variables.
# Hostinger sets PORT. Do not add PORT or the site will not open.
# Use a MongoDB Atlas URI. In Atlas → Network Access, allow 0.0.0.0/0.

MONGO_URL=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/theshutki
DB_NAME=theshutki
JWT_SECRET=change-me-to-a-long-random-string
ADMIN_EMAIL=admin@theshutki.com
ADMIN_PASSWORD=Shutki@2026
SITE_URL=https://theshutki.com

# Optional. Comma-separated frontend origins. Leave empty to allow the calling site.
CORS_ORIGINS=

GOOGLE_CLIENT_ID=
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=

SHIPROCKET_ENABLED=false
SHIPROCKET_API_EMAIL=
SHIPROCKET_API_PASSWORD=
SHIPROCKET_PICKUP_LOCATION=Primary
SHIPROCKET_PICKUP_POSTCODE=
SHIPROCKET_BASE_URL=https://apiv2.shiprocket.in/v1/external
